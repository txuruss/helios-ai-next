# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# AI
ANTHROPIC_API_KEY=

# Security
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ALLOWED_ORIGIN=http://localhost:3001

# Cal.com
CALCOM_API_KEY=
CALCOM_API_VERSION=
CALCOM_WEBHOOK_SECRET=

# Email — Resend (https://resend.com/api-keys)
# Server-side only — NEVER prefix with NEXT_PUBLIC_
RESEND_API_KEY=
# Verified sending domain/email in Resend. Defaults to onboarding@resend.dev in dev.
RESEND_FROM_EMAIL=

# ── Phase 6: Stripe billing ───────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY is server-side only — NEVER prefix with NEXT_PUBLIC_
STRIPE_SECRET_KEY=
# Webhook secret from: https://dashboard.stripe.com/webhooks
# Endpoint: https://yourdomain.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.payment_*
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard → Products (NEXT_PUBLIC_ is safe — they are not secrets)
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_SCALE_PRICE_ID=

# ── Phase 7: Analytics and monitoring ────────────────────────────
# PostHog (https://posthog.com) — safe to expose as NEXT_PUBLIC_
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Sentry (https://sentry.io)
# SENTRY_DSN is server-side. NEXT_PUBLIC_SENTRY_DSN is for the browser.
# SENTRY_AUTH_TOKEN is server-side only — NEVER prefix with NEXT_PUBLIC_
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Phase 8+ placeholders ─────────────────────────────────────────
