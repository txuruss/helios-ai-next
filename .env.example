# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# AI
ANTHROPIC_API_KEY=

# Security
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ALLOWED_ORIGIN=http://localhost:3001

# Cal.com
CALCOM_API_KEY=
CALCOM_API_VERSION=
CALCOM_WEBHOOK_SECRET=

# Email — Resend (https://resend.com/api-keys)
# Server-side only — NEVER prefix with NEXT_PUBLIC_
RESEND_API_KEY=
# Verified sending domain/email in Resend. Defaults to onboarding@resend.dev in dev.
RESEND_FROM_EMAIL=
# Destination for internal audit submission alerts (founder/admin inbox).
# When set, an email is sent after every successful audit form submission.
INTERNAL_ALERT_EMAIL=

# ── Phase 6: Stripe billing ───────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY is server-side only — NEVER prefix with NEXT_PUBLIC_
STRIPE_SECRET_KEY=
# Webhook secret from: https://dashboard.stripe.com/webhooks
# Endpoint: https://yourdomain.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.payment_*
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard → Products (NEXT_PUBLIC_ is safe — they are not secrets)
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_SCALE_PRICE_ID=

# ── Phase 7: Analytics and monitoring ────────────────────────────
# PostHog (https://posthog.com) — safe to expose as NEXT_PUBLIC_
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Sentry (https://sentry.io)
# SENTRY_DSN is server-side. NEXT_PUBLIC_SENTRY_DSN is for the browser.
# SENTRY_AUTH_TOKEN is server-side only — NEVER prefix with NEXT_PUBLIC_
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Phase 8: Relevance AI agent integration ──────────────────────
# Get API key from: https://app.relevanceai.com → Settings → API Keys
# Server-side only — NEVER prefix with NEXT_PUBLIC_
RELEVANCE_API_KEY=
# Your Relevance AI region (e.g. us-east-1, ap-southeast-2)
RELEVANCE_REGION=us-east-1
# Your Relevance AI project ID
RELEVANCE_PROJECT_ID=
# Webhook signing secret (optional — create at app.relevanceai.com → Webhooks)
RELEVANCE_WEBHOOK_SECRET=

# ── Phase 9: WhatsApp Business API ───────────────────────────────
# Get from: https://developers.facebook.com → Your App → WhatsApp → API Setup
# META_ACCESS_TOKEN is server-side only — NEVER prefix with NEXT_PUBLIC_
META_ACCESS_TOKEN=
# From: Meta App → WhatsApp → API Setup → Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=
# From: Meta App → WhatsApp → API Setup → WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Choose any string — paste it as the Verify Token in the Meta App webhook config
WHATSAPP_VERIFY_TOKEN=
# Optional: Meta App Secret from App Settings → Basic → App Secret
# Used to verify x-hub-signature-256 on incoming webhooks
META_APP_SECRET=

# ── Phase 15+: Ops cron secrets ──────────────────────────────────
# Used by the scheduled SLA cron job at /api/cron/ops/sla
# Server-side only — NEVER prefix with NEXT_PUBLIC_
# Set to a strong random string (e.g. openssl rand -base64 32)

# Phase 18: Cron secret priority: CRON_SECRET > VERCEL_CRON_SECRET > OPS_CRON_SECRET
# Use CRON_SECRET for Vercel-native cron (Vercel injects it automatically)
# Use VERCEL_CRON_SECRET as an alternate Vercel-managed secret
# Use OPS_CRON_SECRET for external schedulers (curl, GitHub Actions, etc.)

# Preferred — Vercel native cron protection
CRON_SECRET=

# Alternate Vercel-managed cron secret (Phase 18)
VERCEL_CRON_SECRET=

# Fallback for external schedulers (Phase 15, backward-compatible)
OPS_CRON_SECRET=

# Cron endpoint accepts: Authorization: Bearer ${CRON_SECRET|VERCEL_CRON_SECRET|OPS_CRON_SECRET}
# Priority: CRON_SECRET > VERCEL_CRON_SECRET > OPS_CRON_SECRET

# ── Phase 18+ placeholders ────────────────────────────────────────

# Public booking link — shown on /audit/submitted as "Schedule Your Audit Call"
# Set to your Cal.com or Calendly link. If empty, a fallback message is shown instead.
NEXT_PUBLIC_BOOKING_LINK=
